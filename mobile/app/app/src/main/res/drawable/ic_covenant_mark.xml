<?xml version="1.0" encoding="utf-8"?>
<!-- The operator's emblem (2026-09-12): a Tree of Life, roots mirroring the crown
     inside a ring, with UNITY spelled out in the branches. Paths, not text:
     VectorDrawable draws no glyphs, so the letters are branch-strokes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp" android:height="48dp" android:viewportWidth="100" android:viewportHeight="100">
    <path android:fillColor="@color/accent_soft" android:pathData="M50,4 a46,46 0 1,0 0.01,0z"/>
    <path android:strokeColor="@color/accent" android:strokeWidth="3" android:fillColor="#00000000"
        android:pathData="M50,4 a46,46 0 1,0 0.01,0z"/>
    <group>
        <!-- roots: the crown mirrored -->
        <path android:strokeColor="@color/accent" android:strokeWidth="3" android:strokeLineCap="round" android:fillColor="#00000000"
            android:pathData="M50,80 C42,84 38,88 34,92 M50,80 C58,84 62,88 66,92 M50,82 C46,88 47,91 44,95 M50,82 C54,88 53,91 56,95"/>
        <!-- trunk and branches -->
        <path android:strokeColor="@color/accent" android:strokeWidth="4" android:strokeLineCap="round" android:fillColor="#00000000"
            android:pathData="M50,80 L50,52"/>
        <path android:strokeColor="@color/accent" android:strokeWidth="3" android:strokeLineCap="round" android:fillColor="#00000000"
            android:pathData="M50,62 C40,60 32,54 26,44 M50,62 C60,60 68,54 74,44 M50,55 C44,51 40,46 38,40 M50,55 C56,51 60,46 62,40 M50,52 L50,42"/>
        <!-- UNITY, spelled out in the branches -->
        <path android:strokeColor="@color/accent" android:strokeWidth="3" android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000"
            android:pathData="M21,24 L21,34 Q21,38 25,38 Q29,38 29,34 L29,24 M34,38 L34,24 L42,38 L42,24 M47,24 L47,38 M52,24 L62,24 M57,24 L57,38 M66,24 L71,31 L76,24 M71,31 L71,38"/>
        <!-- leaves -->
        <path android:fillColor="@color/accent" android:pathData="M18,19 a2.4,2.4 0 1,0 0.01,0z M82,19 a2.4,2.4 0 1,0 0.01,0z M50,15 a2.4,2.4 0 1,0 0.01,0z M30,16 a1.8,1.8 0 1,0 0.01,0z M70,16 a1.8,1.8 0 1,0 0.01,0z"/>
    </group>
</vector>
