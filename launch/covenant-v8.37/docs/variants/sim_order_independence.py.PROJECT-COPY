"""ORDER INDEPENDENCE under adversarial delivery.

The 1000-node run confirmed convergence and conservation but died before any
SHUFFLED node finished, so the invariant that actually stresses the item AE
event-claim -- that arrival order cannot change final state -- went untested.
This tests it directly, at a size that completes, with harsher delivery
patterns than the big run used.

DELIVERY PATTERNS
  in-order          the baseline
  reversed          worst case for any accumulate-as-you-go assumption
  shuffled x N      random permutations
  every block twice duplicate delivery
  interleaved       block halves delivered out of phase
  replay-from-zero  full chain re-applied after completion
  interrupted       stop halfway, then finish (models a crashed node resyncing)

Every pattern must land on the same fingerprint. Anything else is a
consensus break.
"""
import os, sys, time, json, random, tempfile, shutil, hashlib
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import covenant_unified_v8 as cov
from cryptography.hazmat.primitives.asymmetric import rsa
from cryptography.hazmat.primitives import serialization

random.seed(4242)
work = tempfile.mkdtemp(prefix="order_")
fails = []

def check(label, cond, detail=""):
    print(("  PASS: " if cond else "  FAIL: ") + label + (f" -- {detail}" if detail else ""))
    if not cond:
        fails.append(label)

N_ACTORS, N_EVENTS = 12, 120
actors = []
for _ in range(N_ACTORS):
    k = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    actors.append((k, k.public_key().public_bytes(
        serialization.Encoding.PEM,
        serialization.PublicFormat.SubjectPublicKeyInfo).decode()))

MINT = 1000.0
model = {p: MINT for _, p in actors}
txs = []
for i in range(N_EVENTS):
    (sk, payer), (_, payee) = random.sample(actors, 2)
    amt = round(random.uniform(0.01, 40.0), 6)
    if model[payer] < amt:
        continue
    ref = cov.Database.node_gift_ref_id(payer, payee, amt, float(i))
    entries = [{"pubkey": payer, "delta": -amt, "reason": "node_gift_sent", "ref_id": ref},
               {"pubkey": payee, "delta": amt, "reason": "node_gift_received", "ref_id": ref}]
    evt = {"entries": entries,
           "auth": {payer: {"kind": "ledger_event_v1",
                            "signature": cov.Database.sign_ledger_event(sk, entries)}}}
    tx = cov.Transaction(sender_pubkey=payer, receiver="collective",
                         data={"origin": "human", "ledger_event": evt},
                         amount=0.0, timestamp=time.time() + i)
    tx.sign(sk)
    txs.append(tx)
    model[payer] -= amt
    model[payee] += amt

blocks, prev = [], "0" * 64
for bi in range(0, len(txs), 6):
    b = cov.Block(index=len(blocks) + 1, transactions=txs[bi:bi + 6],
                  previous_hash=prev, timestamp=time.time() + bi)
    prev = b.compute_hash()
    blocks.append(b)
print(f"{len(txs)} events in {len(blocks)} blocks, {N_ACTORS} actors\n")

def build(name, order):
    d = cov.Database(os.path.join(work, f"{name}.db"))
    for j, (_, pem) in enumerate(actors):
        d.record_ledger_entry(pem, MINT, "genesis_mint", ref_id=f"g{j}")
    for b in order:
        d.apply_transaction_ledger(b)
    return d

def fp(d):
    return hashlib.sha256(json.dumps(
        {p: round(d.get_balance(p), 9) for _, p in actors}, sort_keys=True).encode()).hexdigest()

print("== delivery patterns ==")
patterns = {"in_order": list(blocks),
            "reversed": list(reversed(blocks)),
            "each_twice": [b for b in blocks for _ in range(2)],
            "interleaved": blocks[1::2] + blocks[0::2],
            "replay_full": list(blocks) + list(blocks)}
for i in range(6):
    o = list(blocks)
    random.Random(1000 + i).shuffle(o)
    patterns[f"shuffled_{i}"] = o

results = {}
for name, order in patterns.items():
    d = build(name, order)
    results[name] = fp(d)
    print(f"  {name:<14} {len(order):>3} deliveries -> {results[name][:24]}")

base = results["in_order"]
check(f"all {len(patterns)} delivery patterns reach one identical state",
      len(set(results.values())) == 1,
      f"{len(set(results.values()))} distinct states")
if len(set(results.values())) > 1:
    for n, f in results.items():
        if f != base:
            print(f"    DIVERGED: {n} -> {f[:24]}")

print("\n== interruption and resync ==")
d = cov.Database(os.path.join(work, "interrupt.db"))
for j, (_, pem) in enumerate(actors):
    d.record_ledger_entry(pem, MINT, "genesis_mint", ref_id=f"g{j}")
half = len(blocks) // 2
for b in blocks[:half]:
    d.apply_transaction_ledger(b)
mid_total = sum(d.get_balance(p) for _, p in actors)
check("a node stopped mid-chain still conserves supply",
      abs(mid_total - MINT * N_ACTORS) < 1e-6,
      f"{mid_total:.9f} vs {MINT*N_ACTORS}")
# Resync: peer re-sends the WHOLE chain, not just the missing part.
for b in blocks:
    d.apply_transaction_ledger(b)
check("resyncing the full chain after interruption converges",
      fp(d) == base, f"{fp(d)[:24]} vs {base[:24]}")

print("\n== conservation across every pattern ==")
worst = 0.0
for name in patterns:
    dd = cov.Database(os.path.join(work, f"{name}.db"))
    t = sum(dd.get_balance(p) for _, p in actors)
    worst = max(worst, abs(t - MINT * N_ACTORS))
check("supply exact under every delivery pattern", worst < 1e-6,
      f"worst drift {worst:+.12f}")

print("\n== model agreement ==")
d0 = cov.Database(os.path.join(work, "in_order.db"))
bad = [(round(model[p], 6), round(d0.get_balance(p), 6))
       for _, p in actors if abs(model[p] - d0.get_balance(p)) > 1e-6]
check("ledger matches independently-tracked model", not bad, f"{len(bad)} differ")

shutil.rmtree(work)
print("\n" + "=" * 60)
print(f"{'ALL INVARIANTS HELD' if not fails else str(len(fails)) + ' FAILURES'}")
for f in fails:
    print(f"  - {f}")
print("=" * 60)
sys.exit(1 if fails else 0)
