"""1000-NODE NETWORK SIMULATION.

WHAT IS REAL HERE, stated up front because the distinction decides what a
green result is worth:
  REAL -- 1000 independent Database instances on disk, real SQLite, real
          schema, real RSA-2048 signatures, real Transaction/Block objects,
          the real validate_ledger_event and apply_transaction_ledger code
          paths, real chain replay.
  NOT REAL -- no 1000 OS processes and no 1000 sockets. Propagation is
          modelled by handing each node the same block list, in varying
          order. This tests LEDGER CONVERGENCE, not socket behaviour.
          Socket-level P2P is exercised separately.

INVARIANTS UNDER TEST
  I1  CONVERGENCE: every node given the same blocks computes identical
      balances for every account. Any divergence is a consensus break.
  I2  CONSERVATION: total supply equals what was minted. Ledger events move
      value; they must never create or destroy it.
  I3  ORDER INDEPENDENCE: a node that receives blocks out of order, or
      replays them, lands in the same state as one that saw them once in
      order.
  I4  IDEMPOTENCE: re-applying the whole chain changes nothing.
"""
import os, sys, time, json, random, tempfile, shutil, hashlib, base64
from concurrent.futures import ThreadPoolExecutor
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import covenant_unified_v8 as cov
from cryptography.hazmat.primitives.asymmetric import rsa, padding
from cryptography.hazmat.primitives import serialization, hashes

N_NODES = 1000
N_ACTORS = 40
N_EVENTS = 300

random.seed(20260819)
work = tempfile.mkdtemp(prefix="sim1000_")
findings = []
t0 = time.time()

def check(label, cond, detail=""):
    print(("  PASS: " if cond else "  FAIL: ") + label + (f" -- {detail}" if detail else ""))
    if not cond:
        findings.append(label + (f" -- {detail}" if detail else ""))
    return cond

print("== building actors ==")
actors = []
for i in range(N_ACTORS):
    k = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    pem = k.public_key().public_bytes(
        serialization.Encoding.PEM,
        serialization.PublicFormat.SubjectPublicKeyInfo).decode()
    actors.append((k, pem))
print(f"  {N_ACTORS} actors in {time.time()-t0:.1f}s")

MINT_EACH = 1000.0
TOTAL_MINTED = MINT_EACH * N_ACTORS

# ---------------------------------------------------------------- build chain
print("\n== building a chain of authorized net-zero movements ==")
model = {pem: MINT_EACH for _, pem in actors}
txs = []
built = skipped = 0
for i in range(N_EVENTS):
    (sk, payer), (_, payee) = random.sample(actors, 2)
    amount = round(random.uniform(0.01, 50.0), 6)
    if model[payer] < amount:
        skipped += 1
        continue
    ref = cov.Database.node_gift_ref_id(payer, payee, amount, float(i))
    entries = [
        {"pubkey": payer, "delta": -amount, "reason": "node_gift_sent", "ref_id": ref},
        {"pubkey": payee, "delta": amount, "reason": "node_gift_received", "ref_id": ref},
    ]
    evt = {"entries": entries,
           "auth": {payer: {"kind": "ledger_event_v1",
                            "signature": cov.Database.sign_ledger_event(sk, entries)}}}
    ok, why = cov.Database.validate_ledger_event(evt)
    if not ok:
        findings.append(f"built event rejected by validator: {why}")
        continue
    tx = cov.Transaction(sender_pubkey=payer, receiver="collective",
                         data={"origin": "human", "ledger_event": evt},
                         amount=0.0, timestamp=time.time() + i)
    tx.sign(sk)
    txs.append(tx)
    model[payer] -= amount
    model[payee] += amount
    built += 1
print(f"  {built} events built, {skipped} skipped for insufficient modelled funds")

blocks = []
prev = "0" * 64
for bi in range(0, len(txs), 10):
    b = cov.Block(index=len(blocks) + 1, transactions=txs[bi:bi + 10],
                  previous_hash=prev, timestamp=time.time() + bi)
    prev = b.compute_hash()
    blocks.append(b)
print(f"  {len(blocks)} blocks")

# ------------------------------------------------------------- spin up nodes
print(f"\n== standing up {N_NODES} nodes ==")
t1 = time.time()
nodes = []
for i in range(N_NODES):
    d = cov.Database(os.path.join(work, f"n{i:04d}.db"))
    nodes.append(d)
print(f"  {N_NODES} databases in {time.time()-t1:.1f}s")

print("\n== genesis mint on every node (identical) ==")
t1 = time.time()
for i, d in enumerate(nodes):
    for j, (_, pem) in enumerate(actors):
        d.record_ledger_entry(pem, MINT_EACH, "genesis_mint", ref_id=f"gen{j}")
print(f"  seeded in {time.time()-t1:.1f}s")

# --------------------------------------------------------------- apply chain
print("\n== applying the chain (nodes 0-499 in order, 500-999 shuffled) ==")
t1 = time.time()
def apply_for(idx):
    d = nodes[idx]
    order = list(blocks)
    if idx >= N_NODES // 2:
        rnd = random.Random(idx)
        rnd.shuffle(order)          # I3: out-of-order arrival
        if idx % 7 == 0:
            order = order + order[:5]   # I4: some blocks arrive twice
    for b in order:
        d.apply_transaction_ledger(b)
    return idx

with ThreadPoolExecutor(max_workers=16) as ex:
    list(ex.map(apply_for, range(N_NODES)))
print(f"  applied on {N_NODES} nodes in {time.time()-t1:.1f}s")

# --------------------------------------------------------------- invariants
print("\n== I1: CONVERGENCE ==")
ref_state = {pem: nodes[0].get_balance(pem) for _, pem in actors}
def fingerprint(d):
    return hashlib.sha256(json.dumps(
        {pem: round(d.get_balance(pem), 9) for _, pem in actors},
        sort_keys=True).encode()).hexdigest()

t1 = time.time()
fps = {}
for i, d in enumerate(nodes):
    fps.setdefault(fingerprint(d), []).append(i)
print(f"  fingerprinted {N_NODES} nodes in {time.time()-t1:.1f}s")
check(f"all {N_NODES} nodes agree on every balance",
      len(fps) == 1, f"{len(fps)} distinct network states")
if len(fps) > 1:
    for fp, members in list(fps.items())[:4]:
        print(f"    state {fp[:16]}: {len(members)} nodes, e.g. node {members[0]}")

print("\n== I2: CONSERVATION ==")
total = sum(ref_state.values())
check("total supply is exactly what was minted",
      abs(total - TOTAL_MINTED) < 1e-6,
      f"minted {TOTAL_MINTED} present {total} drift {total - TOTAL_MINTED:+.12f}")
check("no account went negative",
      all(v >= -1e-9 for v in ref_state.values()),
      f"min balance {min(ref_state.values()):.6f}")

print("\n== I3: ORDER INDEPENDENCE ==")
in_order = fingerprint(nodes[0])
shuffled = fingerprint(nodes[N_NODES - 1])
check("a node that received blocks shuffled matches one that did not",
      in_order == shuffled, f"{in_order[:16]} vs {shuffled[:16]}")

print("\n== I4: IDEMPOTENCE (full chain replay) ==")
before = fingerprint(nodes[5])
for b in blocks:
    nodes[5].apply_transaction_ledger(b)
after = fingerprint(nodes[5])
check("replaying the entire chain changes nothing", before == after,
      f"{before[:16]} -> {after[:16]}")

print("\n== I5: MODEL AGREEMENT ==")
mismatch = [(pem[:0], round(model[pem], 6), round(ref_state[pem], 6))
            for _, pem in actors if abs(model[pem] - ref_state[pem]) > 1e-6]
check("ledger matches the independently-tracked model",
      not mismatch, f"{len(mismatch)} accounts differ")

shutil.rmtree(work)
print("\n" + "=" * 66)
print(f"{N_NODES} nodes, {len(blocks)} blocks, {built} events, "
      f"{time.time()-t0:.1f}s total")
print(f"FINDINGS: {len(findings)}")
for f in findings[:12]:
    print(f"  - {f}")
print("=" * 66)
