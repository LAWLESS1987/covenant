#!/bin/sh
# HELD-COPY AUTOSYNC hook (asked 2026-09-14: "it should automatically adjust").
# Install once:  cp ops/pre-commit.synchold .git/hooks/pre-commit
#
# WHAT IT IS FOR. test_p18_version_collision.py V3 forbids any other copy of
# covenant_unified_v8*.py from declaring the live COVENANT_VERSION with different
# bytes. Keeping that true when the core changes was a manual `cp`, and manual
# steps are forgotten: on 2026-09-14 the core changed three times in an afternoon,
# the held copy under pending-v8.38/ was re-synced once, and because
# .git/hooks/post-commit pushes every commit at once, the sweep went red on GitHub
# THIRTY-SEVEN times in a row -- one per commit -- for a copy nobody had made.
# P18's own docstring already called pending-v8.38 the case V3 was written for
# "twice". This was the third. So the copy happens here now, in the same commit
# as the core change, which is the only place it is ever correct.
#
# IT MUST NEVER BLOCK A COMMIT. Same rule as the post-commit autosync beside it:
# what to do about something this cannot fix is the operator's call, and a hook
# that refuses work is a hook that gets deleted. A .PRE- backup colliding with the
# live version, or a copy this repository does not track, is REPORTED at length
# and left alone -- never silently flattened. Every path below ends `exit 0`.
#
# ORDER MATTERS (2026-09-19). Three steps, in this order, because each one
# changes what the next one hashes:
#   1. sync the held core copy (only when the core is in this commit);
#   2. stage any held copy that differs from the index -- twice now a copy was
#      synced into the working tree and never staged (7ffa73b, 171fb86),
#      because the sync tool says "in sync" about a file the INDEX has never
#      seen;
#   3. regenerate MANIFEST.sha256 on every FULL commit -- one where no staged
#      file also has unstaged changes -- under the rule this hook always had:
#      never describe content the commit does not contain. On a partial
#      commit (`git add -p`) the manifest is left alone and the hook says so.
#      Before this, every ordinary commit left the manifest one step behind,
#      the highway's manifest_stale fired after each, and a person ran
#      `verify_bundle.py --write` by hand and committed "Manifest: ..." after
#      every change (A155).
#   Not measured here and said so: tracked files the running system rewrites
#   (fallback_model.json, ops/verdicts.jsonl ...) are hashed as they are on
#   disk, exactly as the hand-run did.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" 2>/dev/null || exit 0

rc=0
if git diff --cached --name-only 2>/dev/null | grep -qx "covenant_unified_v8.py"; then
  # ---- 1. the held copy follows the core, in the same commit
  out=$(python covenant_sync_held_core.py 2>&1)
  rc=$?
  echo "$out" | sed 's/^/pre-commit: /'
  # ---- 2. a held copy the index has not seen is staged, whatever the tool said
  for f in $(git ls-files 'pending-*/covenant_unified_v8.py' 2>/dev/null); do
    if ! git diff --quiet -- "$f" 2>/dev/null; then
      git add -- "$f" 2>/dev/null && echo "pre-commit: staged $f into this commit"
    fi
  done
fi

# ---- 3. the manifest, on every full commit
staged=$(git diff --cached --name-only 2>/dev/null)
if [ -n "$staged" ]; then
  partial=""
  for f in $(git diff --name-only 2>/dev/null); do
    for g in $staged; do
      [ "$f" = "$g" ] && partial="$partial $f"
    done
  done
  if [ -n "$partial" ]; then
    echo "pre-commit: manifest left alone -- partially staged:$partial (run 'python verify_bundle.py --write' after the commit)"
  elif python verify_bundle.py --write >/dev/null 2>&1; then
    if ! git diff --quiet -- MANIFEST.sha256 2>/dev/null; then
      git add -- MANIFEST.sha256 2>/dev/null && echo "pre-commit: MANIFEST.sha256 regenerated and staged (full commit)"
    fi
  else
    echo "pre-commit: could NOT regenerate MANIFEST.sha256 -- run 'python verify_bundle.py --write' yourself" >&2
  fi
fi

if [ "$rc" -ne 0 ]; then
  echo "pre-commit: something above was left for a person. The commit is NOT blocked." >&2
  echo "pre-commit: read the REFUSED / left alone lines -- a .PRE- backup must be renamed by hand, never overwritten." >&2
fi
exit 0
